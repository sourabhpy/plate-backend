# Plate Backend Configuration Example
# Copy to .env and configure appropriately

SECRET_KEY=replace_with_a_secure_django_secret_key_in_production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# In local development without Postgres, ISLOCALMACHINE=True defaults to SQLite
ISLOCALMACHINE=True
DATABASE_NAME=plate_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432

# CORS Allowed Origins (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google GenAI / Gemini Key for Audio Transcription, Analysis, and Embeddings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=gemini-3.1-flash-lite

# Email Configuration (for assignment / status change notifications)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your_email_host_password
DEFAULT_FROM_EMAIL=Plate Alerts <notifications@plate.local>
